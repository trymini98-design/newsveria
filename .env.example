# NewsVeria environment — values are set in the Vercel project (production). Adsterra codes configured 2026-10-10.
# Public site URL, e.g. https://newsveria.vercel.app
NEXT_PUBLIC_SITE_URL=
# Public newsroom contact email (shown on the Contact page only when set)
NEXT_PUBLIC_CONTACT_EMAIL=
# Adsterra: paste only Maria-approved ad codes; placements stay empty until set
NEXT_PUBLIC_ADSTERRA_BANNER_CODE=
NEXT_PUBLIC_ADSTERRA_INARTICLE_CODE=
NEXT_PUBLIC_ADSTERRA_SIDEBAR_CODE=
# Google Analytics 4 measurement ID (after Maria authorizes)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console HTML-tag verification content value (after Maria authorizes)
NEXT_PUBLIC_GSC_VERIFICATION=
