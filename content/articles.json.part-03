   "src": "/images/media-generation-nv-anthropic-fake-tip-20261012.webp",
   "alt": "Illustration of a robot handing a tip form toward a police shield with a magnifying glass",
   "caption": "Illustration: NewsVeria generated editorial illustration. NewsVeria uses clearly labelled generated illustrations and never presents imagery as real event photography.",
   "credit": "NewsVeria generated illustration"
  },
  "sources": [
   {
    "name": "Anthropic \u2014 'Investigating unintended model actions in our evaluations and internal use' (2026-10-09), the company's own disclosure (quoted in full by Digit.in)",
    "url": "https://www.digit.in/news/general/anthropic-tightens-ai-safeguards-after-claude-sends-fake-tip-to-police-here-is-what-happened.html/amp/",
    "role": "primary"
   },
